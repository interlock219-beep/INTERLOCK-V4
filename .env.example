# IntentLock v4.0 Configuration
# Copy to .env and adjust for your environment.

# --- Application ---
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# SQLite (development)
DATABASE_URL=sqlite:///./intentlock.db
# PostgreSQL (production)
# DATABASE_URL=postgresql+psycopg2://intentlock:password@db:5432/intentlock

# PostgreSQL credentials (used by docker-compose)
# POSTGRES_USER=intentlock
# POSTGRES_PASSWORD=change-me-to-a-secure-random-value

# --- Security ---
# JWT_SECRET_KEY must be a cryptographically secure random value (min 32 chars).
# It is required in staging and production; development generates a process-local value if omitted.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_CLOCK_SKEW_SECONDS=30

# Ed25519 execution token key (optional; generated if not provided)
# EXECUTION_KEY_PATH=/path/to/execution_key.pem
EXECUTION_TOKEN_TTL_SECONDS=1

BCRYPT_ROUNDS=12

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Redis ---
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=change-me-to-a-secure-random-value
REDIS_ENABLED=false

# --- Rate limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_INTENT_PER_MINUTE=60

# --- HITL ---
HITL_TTL_SECONDS=300

# --- Velocity tracking ---
VELOCITY_WINDOW_SECONDS=60
VELOCITY_MAX_REQUESTS=100
VELOCITY_MAX_CUMULATIVE_VALUE=10000
VELOCITY_MAX_CUMULATIVE_RISK=5
VELOCITY_MAX_SENSITIVE_OPERATIONS=10

# --- Webhooks ---
# WEBHOOK_HMAC_SECRET=change-me-to-a-secure-random-value
WEBHOOK_TIMEOUT_SECONDS=10

# --- Billing ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- MFA ---
# MFA_ENABLED=false
# MFA_ISSUER_NAME=IntentLock
# MFA_BACKUP_CODES_COUNT=10

# --- Password Reset ---
# PASSWORD_RESET_TOKEN_TTL_SECONDS=3600

# --- Email Verification ---
# EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400

# --- Sessions ---
# SESSION_TTL_SECONDS=604800
# REFRESH_TOKEN_ENABLED=false
